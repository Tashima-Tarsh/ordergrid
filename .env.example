NODE_ENV=production
PORT=3000
APP_ORIGIN=https://orders.example.in
DATABASE_URL=postgresql://user:password@host:5432/ordergrid
REDIS_URL=redis://host:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
BOOTSTRAP_ADMIN_EMAIL=owner@example.in
BOOTSTRAP_ADMIN_PASSWORD=replace-on-first-login
# One-time/protected owner signup and recovery code. Keep this secret and rotate/remove it after setup.
ORDERGRID_SIGNUP_CODE=replace-with-at-least-12-random-characters
SHOPIFY_STOREFRONT_TOKEN=
CARD_PROVIDER=disabled
CARD_PROVIDER_API_KEY=
CARD_PROVIDER_WEBHOOK_SECRET=

# Real virtual card issuer (required when CARD_PROVIDER=enkash)
# Use the production URLs and credentials supplied during EnKash partner onboarding.
ENKASH_BASE_URL=
ENKASH_TOKEN_URL=
ENKASH_PARTNER_ID=
ENKASH_BASIC_AUTH=
ENKASH_USERNAME=
ENKASH_PASSWORD=
ENKASH_CLIENT_ID=
ENKASH_COMPANY_ID=
ENKASH_CARD_ACCOUNT_ID=

# Default cardholder profile used only when Autopilot provisions an issuer-backed card.
# Do not put card PAN/CVV here; these fields are identity/KYC inputs required by the issuer.
CARDHOLDER_EMAIL=
CARDHOLDER_MOBILE=
CARDHOLDER_FIRST_NAME=
CARDHOLDER_LAST_NAME=
CARDHOLDER_GENDER=
CARDHOLDER_PAN=
CARDHOLDER_SPECIAL_DATE=

# Machine token required by the native Chrome worker in production.
WORKER_API_TOKEN=
DB_SSL_REJECT_UNAUTHORIZED=true
