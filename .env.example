NODE_ENV=production
PORT=3000
APP_ORIGIN=http://localhost:3000

# Database Configuration (Docker Compose internal network)
DATABASE_URL=postgres://ordergrid:YOUR_SECURE_POSTGRES_PASSWORD@db:5432/ordergrid
REDIS_URL=redis://redis:6379

# Cryptographic Keys (Generate with: openssl rand -base64 32)
SESSION_SECRET=
DATA_ENCRYPTION_KEY_BASE64=
WORKER_API_TOKEN=

# Bootstrap Owner Account
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
