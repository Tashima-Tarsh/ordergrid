# OrderGrid local-first configuration
# Copy to .env.local only if you prefer manual setup.
NODE_ENV=production
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_POOL_MAX=5
DB_SSL_REJECT_UNAUTHORIZED=true
WORKER_API_TOKEN=generate-a-random-64-character-token
SESSION_SECRET=generate-a-long-random-secret
DATA_ENCRYPTION_KEY_BASE64=generate-at-least-40-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password
CARD_PROVIDER=disabled
ORDERGRID_MANAGED_EXECUTION=false
